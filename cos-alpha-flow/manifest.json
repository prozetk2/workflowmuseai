{
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "name": "cos_alpha_flow",
  "version": "1.13.1",
  "description": "cos_alpha_flow: node workflow, queue, AI script writer and project album for Google Flow, ChatGPT, Grok, Muse and Gemini (your signed-in tabs) or the Gemini API.",
  "action": {
    "default_title": "Mở cos_alpha_flow (bảng bên)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "debugger",
    "sidePanel",
    "downloads",
    "contextMenus",
    "activeTab"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://storage.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "https://flow-content.google/*",
    "https://generativelanguage.googleapis.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "https://*.oaiusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "flow-page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "flow-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "chat-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://muse.ai/*",
        "https://*.muse.ai/*"
      ],
      "js": [
        "muse-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}