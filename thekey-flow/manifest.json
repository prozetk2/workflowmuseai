{
  "manifest_version": 3,
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" },
  "name": "TheKey.studio Flow",
  "version": "0.3.0",
  "description": "TheKey.studio visual workflow canvas for Google Flow (Veo) or the Gemini API.",
  "action": { "default_title": "Open TheKey.studio Flow", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs", "scripting", "debugger"],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://storage.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/fx/*"],
      "js": ["flow-page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/fx/*"],
      "js": ["flow-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
